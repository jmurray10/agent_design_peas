{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "support ticket",
  "type": "object",
  "required": [
    "ticket_id",
    "summary"
  ],
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "product_area": {
      "type": "string"
    },
    "customer_tier": {
      "type": "string",
      "enum": [
        "free",
        "standard",
        "premium"
      ]
    },
    "prior_tickets": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
