{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routing decision",
  "type": "object",
  "required": [
    "action",
    "reason"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "assign_fast_track",
        "assign_adjuster",
        "request_documents",
        "refer_to_siu",
        "refer_to_coverage_review"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Why this queue, written for the human who receives the claim."
    }
  },
  "additionalProperties": false
}
