{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scheduling decision",
  "type": "object",
  "required": [
    "action",
    "reason"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "propose_schedule",
        "report_unsatisfiable",
        "request_missing_constraints"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Visit -> slot. Empty when nothing is assigned."
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
