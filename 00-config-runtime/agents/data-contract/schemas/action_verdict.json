{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contract verdict",
  "type": "object",
  "required": [
    "action",
    "reason"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "approve_compatible",
        "require_migration_window",
        "block_breaking_change",
        "require_consumer_signoff"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "affected_consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
