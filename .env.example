# Copy to .env and fill in whichever backend you want. None of this is required:
# with nothing set, every example replays a recorded real response from
# shared/transcripts/ and runs with no key, no network, and no install.
#
# .env is gitignored. .env.example is not, and must never contain a real value.

# Anthropic. The models the tiers map to are in shared/providers.yaml.
ANTHROPIC_API_KEY=

# Google. Reached over the REST endpoint, so no SDK is needed.
GEMINI_API_KEY=

# Any server speaking the OpenAI chat-completions protocol: vLLM, Together,
# Groq, OpenRouter, LM Studio, and the Hugging Face router at
# https://router.huggingface.co/v1 -- pair that base URL with a Hugging Face
# token as OPENAI_COMPATIBLE_API_KEY.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Ollama, if it is not on the default http://localhost:11434
OLLAMA_HOST=

# Force one backend instead of letting the shim choose. One of:
# replay, anthropic, gemini, ollama, openai_compatible
LLM_PROVIDER=

# Set to 1 while running live to capture responses into shared/transcripts/.
# Recording fills in what is missing; LLM_RECORD=fresh discards and re-records.
LLM_RECORD=
